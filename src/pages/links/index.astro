---
import Layout from '@/layouts/Layout.astro'
---

<Layout>
  <main class="flex min-h-screen items-center justify-center px-4 pt-16">
    <section class="w-full max-w-xl text-center">
      <p class="text-sm font-medium text-primary">友情链接</p>
      <h1 class="mt-3 text-4xl font-bold text-foreground">施工中</h1>
      <p class="mt-4 text-muted">友链页面正在整理，完成后会在这里展示。</p>
      <a
        href="/"
        class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md border border-border px-4 py-2 font-medium text-foreground transition-colors hover:bg-muted"
      >
        返回首页
      </a>
    </section>
  </main>
</Layout>
