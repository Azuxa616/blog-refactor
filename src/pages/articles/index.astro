---
// 全部文章：保留关键词搜索与分页，分区链接进入对应目录索引。
import BlogItem from '@/components/content/BlogItem.astro'
import Card from '@/components/layout/Card.astro'
import ImageHeaderBar from '@/components/layout/ImageHeaderBar.astro'
import Pagination from '@/components/react/Pagination'
import { getAllPosts, getPostPath } from '@/lib/utils/posts'
import type { PostWithSlug } from '@/lib/utils/posts'
import { getSectionName } from '@/lib/utils/section-names'
import { getTopSections } from '@/lib/utils/tree'
import Layout from '@/layouts/Layout.astro'

export const prerender = false

const { searchParams } = Astro.url
const searchTerm = searchParams.get('search') || ''
const sortType = searchParams.get('sort') || 'latest'
const currentPage = Math.max(1, parseInt(searchParams.get('page') || '1', 10))
const articlesPerPage = 6

const allPosts = await getAllPosts()
const sections = getTopSections(allPosts)

let filteredPosts = allPosts
if (searchTerm) {
  const term = searchTerm.toLowerCase()
  filteredPosts = filteredPosts.filter(
    (post) =>
      post.data.title.toLowerCase().includes(term) ||
      post.data.description.toLowerCase().includes(term),
  )
}

if (sortType === 'latest') {
  filteredPosts.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  )
}

const startIndex = (currentPage - 1) * articlesPerPage
const posts = filteredPosts.slice(startIndex, startIndex + articlesPerPage)
const totalPages = Math.ceil(filteredPosts.length / articlesPerPage)
---

<Layout class="min-h-screen bg-background">
  <ImageHeaderBar
    src="/imgs/index-bg-img-04.png"
    title="Articles"
    subtitle="文章"
  />
  <div class="w-full max-w-6xl mx-auto px-4 py-12">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- 侧边栏 -->
      <div class="flex flex-col gap-6 lg:w-80 flex-shrink-0">
        <!-- 搜索框 -->
        <form method="GET" class="relative">
          <input
            type="text"
            name="search"
            placeholder="输入关键词搜索..."
            value={searchTerm}
            class="w-full px-4 py-2 border-2 border-ink rounded-md bg-card-background text-foreground focus:outline-none focus:border-primary"
          />
          <button type="submit" class="absolute right-3 top-2.5" title="搜索">
            <img
              src="/svgs/search.svg"
              width="20"
              height="20"
              class="text-gray-400 hover:text-gray-600"
              alt="搜索"
            />
          </button>
        </form>

        <!-- 分区导航 -->
        <nav aria-label="分区导航" class="panel p-8 flex flex-col gap-4">
          <h2 class="text-lg font-bold text-foreground mb-2">分区导航</h2>
          <div class="flex flex-wrap gap-3">
            {
              sections.map((section) => (
                <a
                  href={`/articles/${encodeURIComponent(section.slugPath)}`}
                  class="chip inline-flex items-center gap-2 px-3 py-1 text-sm font-semibold transition-colors hover:bg-muted-bg"
                >
                  <span class="h-2.5 w-2.5 bg-primary"></span>
                  {getSectionName(section.name)} ({section.postCount})
                </a>
              ))
            }
          </div>
          <a href="/archive" class="mt-2 text-sm font-medium text-primary hover:underline">
            查看完整目录树 →
          </a>
        </nav>
      </div>

      <!-- 主内容区 -->
      <div class="flex-1">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-foreground mb-2">所有文章</h2>
          <p class="text-muted">
            共找到 {filteredPosts.length} 篇文章
            {searchTerm && `，包含关键词"${searchTerm}"`}
          </p>
        </div>

        <div class="flex flex-col gap-6 mb-8">
          {
            posts.length > 0 ? (
              posts.map((post: PostWithSlug) => {
                const path = getPostPath(post)
                return (
                  <a href={`/articles/${path.split('/').map(encodeURIComponent).join('/')}`}>
                    <BlogItem
                      coverImage={post.data.coverImage || ''}
                      title={post.data.title}
                      description={post.data.description}
                      section={getSectionName(path.split('/')[0])}
                      publishDate={post.data.publishDate.toISOString().split('T')[0]}
                    />
                  </a>
                )
              })
            ) : (
              <Card>
                <div class="text-center py-12">
                  <img
                    src="/svgs/file-text.svg"
                    width="64"
                    height="64"
                    class="mx-auto mb-4"
                    alt="文件"
                  />
                  <h3 class="text-lg font-medium text-gray-600 mb-2">暂无文章</h3>
                  <p class="text-gray-500">
                    {searchTerm ? '没有找到匹配的文章，请尝试其他关键词' : '暂无文章'}
                  </p>
                </div>
              </Card>
            )
          }
        </div>

        {
          totalPages > 1 && (
            <Pagination
              client:visible
              currentPage={currentPage}
              totalPages={totalPages}
              basePath="/articles"
              searchParams={{
                ...(searchTerm ? { search: searchTerm } : {}),
                ...(sortType && sortType !== 'latest' ? { sort: sortType } : {}),
              }}
            />
          )
        }
      </div>
    </div>
  </div>
</Layout>
