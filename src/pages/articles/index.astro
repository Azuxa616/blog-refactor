---
// 文章列表页
import ImageHeaderBar from '@/components/ImageHeaderBar';
import BlogItem from '@/components/BlogItem';
import CategoryFilter from '@/components/CategoryFilter';
import Card from '@/components/Card';
import { storage } from '@/lib/storage';
import type { ArticleStatus } from '@/types/article';

export const prerender = false;

type SortType = "latest" | "popular" | "category";

function formatDateToISO(dateString?: string): string | undefined {
  if (!dateString) return undefined;
  const date = new Date(dateString);
  if (Number.isNaN(date.getTime())) return undefined;
  return date.toISOString().split("T")[0];
}

const { searchParams } = Astro.url;
const searchTerm = searchParams.get("search") || "";
const selectedCategory = searchParams.get("category") || "all";
const sortType = (searchParams.get("sort") || "latest") as SortType;
const currentPage = Math.max(1, parseInt(searchParams.get("page") || "1", 10));
const articlesPerPage = 6;

let sortBy: "createdAt" | "publishedAt" | "viewCount" = "publishedAt";
let sortOrder: "asc" | "desc" = "desc";

switch (sortType) {
  case "latest":
    sortBy = "publishedAt";
    sortOrder = "desc";
    break;
  case "popular":
    sortBy = "viewCount";
    sortOrder = "desc";
    break;
  case "category":
    sortBy = "createdAt";
    sortOrder = "asc";
    break;
}

const articlesResult = await storage.getArticles({
  status: "PUBLISHED" as ArticleStatus,
  categoryId: selectedCategory !== "all" ? selectedCategory : undefined,
  search: searchTerm || undefined,
  page: currentPage,
  limit: articlesPerPage,
  sortBy,
  sortOrder,
});

const categories = await storage.getCategories();

interface ArticleListItem {
  id: string;
  title: string;
  slug: string;
  excerpt?: string;
  coverImage?: string;
  status: string;
  publishedAt?: string;
  createdAt: string;
  viewCount: number;
  categoryId: string;
  category?: {
    id: string;
    name: string;
    color?: string;
  };
  tags?: string[];
  readTime?: number;
}

const articles = articlesResult.items.map((article: ArticleListItem) => {
  const publishDateValue = formatDateToISO(article.publishedAt || article.createdAt);
  return {
    id: article.id,
    title: article.title,
    slug: article.slug,
    excerpt: article.excerpt,
    coverImage: article.coverImage,
    status: article.status?.toLowerCase() || "published",
    publishedAt: article.publishedAt || publishDateValue,
    publishDate: publishDateValue,
    createdAt: article.createdAt,
    viewCount: article.viewCount,
    categoryId: article.categoryId,
    category: article.category
      ? { id: article.category.id, name: article.category.name, color: article.category.color }
      : undefined,
    tags: article.tags,
    readTime: article.readTime || (article.content ? Math.ceil(article.content.length / 400) : undefined),
  };
});

const categoriesWithCount = categories.map((category) => ({
  ...category,
  articleCount: category.articleCount,
}));

const totalCount = articlesResult.pagination.total;
const totalPages = articlesResult.pagination.totalPages;

function buildUrl(updates: { search?: string; category?: string | "all"; sort?: SortType; page?: number }): string {
  const params = new URLSearchParams();
  const newSearch = updates.search !== undefined ? updates.search : searchTerm;
  const newSort = updates.sort !== undefined ? updates.sort : sortType;
  const newCategory = updates.category !== undefined ? updates.category : selectedCategory;
  const newPage = updates.page !== undefined ? updates.page : (updates.search !== undefined || updates.category !== undefined || updates.sort !== undefined ? 1 : currentPage);

  if (newSearch) params.set("search", newSearch);
  if (newCategory && newCategory !== "all") params.set("category", newCategory);
  if (newSort !== "latest") params.set("sort", newSort);
  if (newPage > 1) params.set("page", newPage.toString());

  return params.toString() ? `?${params.toString()}` : "";
}
---

<div class="min-h-screen bg-background">
  <ImageHeaderBar
    client:load
    src="/imgs/index-bg-img-04.png"
    title="文章"
    subtitle="在这里你可以找到我所有的文章"
  />

  <div class="w-full max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- 侧边栏 -->
      <div class="flex flex-col gap-6 lg:w-80 flex-shrink-0">
        <!-- 搜索框 -->
        <div class="flex flex-col gap-4">
          <form method="GET" class="relative">
            <input
              type="text"
              name="search"
              placeholder="输入关键词搜索..."
              value={searchTerm}
              class="w-full px-4 py-2 border border-gray-200 rounded-lg bg-card-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
            />
            <button type="submit" class="absolute right-3 top-2.5" title="搜索">
              <svg class="w-5 h-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
            {sortType !== "latest" && <input type="hidden" name="sort" value={sortType} />}
            {selectedCategory !== "all" && <input type="hidden" name="category" value={selectedCategory} />}
          </form>
        </div>

        <!-- 分类筛选器 -->
        <CategoryFilter
          client:load
          categories={categoriesWithCount}
          selectedCategory={selectedCategory}
          searchTerm={searchTerm}
          sortType={sortType}
        />
      </div>

      <!-- 主内容区 -->
      <div class="flex-1">
        <!-- 结果统计 -->
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-foreground mb-2">
            {selectedCategory && selectedCategory !== "all"
              ? categoriesWithCount.find((c) => c.id === selectedCategory)?.name || selectedCategory
              : "所有文章"}
          </h2>
          <p class="text-muted">
            共找到 {articles.length} 篇文章
            {searchTerm && `，包含关键词"${searchTerm}"`}
          </p>
        </div>

        <!-- 文章列表 -->
        <div class="flex flex-col gap-6 mb-8">
          {articles.length > 0 ? (
            articles.map((article) => (
              <a href={`/articles/${article.id}`}>
                <BlogItem
                  client:visible
                  coverImage={article.coverImage || ""}
                  title={article.title}
                  description={article.excerpt || "暂无摘要"}
                  category={{
                    name: article.category?.name || "未分类",
                    color: article.category?.color,
                  }}
                  publishDate={article.publishDate || article.publishedAt || article.createdAt || "未知时间"}
                  viewCount={article.viewCount}
                />
              </a>
            ))
          ) : (
            <Card>
              <div class="text-center py-12">
                <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="text-lg font-medium text-gray-600 mb-2">暂无文章</h3>
                <p class="text-gray-500">
                  {searchTerm ? "没有找到匹配的文章，请尝试其他关键词" : "该分类下暂无文章"}
                </p>
              </div>
            </Card>
          )}
        </div>

        <!-- 分页 -->
        {totalPages > 1 && (
          <div class="flex justify-center items-center gap-2">
            {currentPage > 1 ? (
              <a
                href={buildUrl({ page: currentPage - 1 })}
                class="px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-600 hover:bg-gray-200"
              >
                上一页
              </a>
            ) : (
              <span class="px-3 py-2 rounded-lg text-sm font-medium opacity-50 cursor-not-allowed bg-gray-100 text-gray-400">
                上一页
              </span>
            )}

            {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
              const pageNumber = i + 1;
              return (
                <a
                  href={buildUrl({ page: pageNumber })}
                  class={`px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
                    currentPage === pageNumber
                      ? "bg-primary text-white shadow-lg"
                      : "bg-gray-100 text-gray-600 hover:bg-gray-200"
                  }`}
                >
                  {pageNumber}
                </a>
              );
            })}

            {currentPage < totalPages ? (
              <a
                href={buildUrl({ page: currentPage + 1 })}
                class="px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-600 hover:bg-gray-200"
              >
                下一页
              </a>
            ) : (
              <span class="px-3 py-2 rounded-lg text-sm font-medium opacity-50 cursor-not-allowed bg-gray-100 text-gray-400">
                下一页
              </span>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</div>
