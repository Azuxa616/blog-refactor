---
// 文章列表页
// 使用 Alpine.js 管理筛选和分页
// 添加中文注释

import ImageHeaderBar from '@/components/layout/ImageHeaderBar.astro'
import BlogItem from '@/components/content/BlogItem.astro'
import CategoryFilter from '@/components/interactions/CategoryFilter.astro'
import Card from '@/components/layout/Card.astro'
import Pagination from '@/components/react/Pagination'
import { getAllPosts } from '@/lib/utils/posts'
import { getCategories } from '@/lib/utils/categories'
import type { PostWithSlug } from '@/lib/utils/posts'
import Layout from '@/layouts/Layout.astro'

export const prerender = false

const { searchParams } = Astro.url
const searchTerm = searchParams.get('search') || ''
const selectedCategory = searchParams.get('category') || 'all'
const sortType = searchParams.get('sort') || 'latest'
const currentPage = Math.max(1, parseInt(searchParams.get('page') || '1', 10))
const articlesPerPage = 6

// 获取所有文章和分类
const allPosts = await getAllPosts()
const categories = await getCategories()

// 筛选文章
let filteredPosts = allPosts

if (selectedCategory !== 'all') {
  filteredPosts = filteredPosts.filter(
    (post) => post.data.category === selectedCategory,
  )
}

if (searchTerm) {
  const term = searchTerm.toLowerCase()
  filteredPosts = filteredPosts.filter(
    (post) =>
      post.data.title.toLowerCase().includes(term) ||
      post.data.description.toLowerCase().includes(term),
  )
}

// 排序
if (sortType === 'latest') {
  filteredPosts.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  )
}

// 分页
const startIndex = (currentPage - 1) * articlesPerPage
const endIndex = startIndex + articlesPerPage
const posts = filteredPosts.slice(startIndex, endIndex)
const totalPages = Math.ceil(filteredPosts.length / articlesPerPage)

// 格式化分类数据以匹配 CategoryFilter 组件期望的类型
const formattedCategories = categories.map((cat) => ({
  name: cat.data.name,
  slug: cat.data.slug,
  description: cat.data.description,
  color: cat.data.color,
  articleCount: cat.articleCount,
}))
---

<Layout class="min-h-screen bg-background">
  <ImageHeaderBar
    src="/imgs/index-bg-img-04.png"
    title="文章"
    subtitle="在这里你可以找到我所有的文章"
  />

  <div class="w-full max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- 侧边栏 -->
      <div class="flex flex-col gap-6 lg:w-80 flex-shrink-0">
        <!-- 搜索框 -->
        <form method="GET" class="relative">
          <input
            type="text"
            name="search"
            placeholder="输入关键词搜索..."
            value={searchTerm}
            class="w-full px-4 py-2 border border-gray-200 rounded-lg bg-card-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
          />
          <button type="submit" class="absolute right-3 top-2.5" title="搜索">
            <img
              src="/svgs/search.svg"
              width="20"
              height="20"
              class="text-gray-400 hover:text-gray-600"
              alt="搜索"
            />
          </button>
        </form>

        <!-- 分类筛选器 -->
        <CategoryFilter
          categories={formattedCategories}
          selectedCategory={selectedCategory}
          searchTerm={searchTerm}
          sortType={sortType}
        />
      </div>

      <!-- 主内容区 -->
      <div class="flex-1">
        <!-- 结果统计 -->
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-foreground mb-2">
            {
              selectedCategory && selectedCategory !== 'all'
                ? categories.find((c) => c.data.slug === selectedCategory)?.data
                    .name || selectedCategory
                : '所有文章'
            }
          </h2>
          <p class="text-muted">
            共找到 {filteredPosts.length} 篇文章
            {searchTerm && `，包含关键词"${searchTerm}"`}
          </p>
        </div>

        <!-- 文章列表 -->
        <div class="flex flex-col gap-6 mb-8">
          {
            posts.length > 0 ? (
              posts.map((post: PostWithSlug) => (
                <a href={`/articles/${post.slug}`}>
                  <BlogItem
                    coverImage={post.data.coverImage || ''}
                    title={post.data.title}
                    description={post.data.description}
                    category={{
                      name:
                        categories.find(
                          (c) => c.data.slug === post.data.category,
                        )?.data.name || '未分类',
                      color: categories.find(
                        (c) => c.data.slug === post.data.category,
                      )?.data.color,
                    }}
                    publishDate={
                      post.data.publishDate.toISOString().split('T')[0]
                    }
                  />
                </a>
              ))
            ) : (
              <Card>
                <div class="text-center py-12">
                  <img
                    src="/svgs/file-text.svg"
                    width="64"
                    height="64"
                    class="mx-auto mb-4"
                    alt="文件"
                  />
                  <h3 class="text-lg font-medium text-gray-600 mb-2">
                    暂无文章
                  </h3>
                  <p class="text-gray-500">
                    {searchTerm
                      ? '没有找到匹配的文章，请尝试其他关键词'
                      : '该分类下暂无文章'}
                  </p>
                </div>
              </Card>
            )
          }
        </div>

        <!-- 分页 -->
        {
          totalPages > 1 && (
            <Pagination 
              currentPage={currentPage} 
              totalPages={totalPages}
              basePath="/articles"
              searchParams={{
                ...(selectedCategory !== 'all' ? { category: selectedCategory } : {}),
                ...(searchTerm ? { search: searchTerm } : {}),
                ...(sortType && sortType !== 'latest' ? { sort: sortType } : {})
              }}
            />
          )
        }
      </div>
    </div>
  </div>
</Layout>
