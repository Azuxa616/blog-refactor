---
// GithubHeatmap.astro
// GitHub 贡献热力图组件
// 展示近 6 周的提交热力图

interface ContributionCell {
  date: string
  count: number
}

interface ContributionSnapshot {
  weeks: ContributionCell[][]
  total: number
  activeDays: number
  currentStreak: number
  longestStreak: number
}

interface Props {
  /** 贡献快照数据 */
  contribution: ContributionSnapshot
}

const { contribution } = Astro.props

// 根据贡献值获取颜色类
const getHeatClass = (value: number): string => {
  if (value === 0) return "bg-slate-200/70"
  if (value === 1) return "bg-emerald-200/80"
  if (value === 2) return "bg-emerald-300/80"
  if (value === 3) return "bg-emerald-500/80"
  return "bg-emerald-600"
}
---

<div class="grid grid-cols-7 gap-1.5">
  <!-- 星期标签 -->
  <div class="text-[10px] text-slate-400 text-center">Mon</div>
  <div class="text-[10px] text-slate-400 text-center">Wed</div>
  <div class="text-[10px] text-slate-400 text-center">Fri</div>

  <!-- 热力图格子 -->
  {contribution.weeks.map((week, _weekIndex) => (
    <div class="contents">
      {week.map((cell, _dayIndex) => (
        <div
          class={`aspect-square rounded-sm transition-all duration-200 hover:scale-110 hover:shadow-md ${getHeatClass(cell.count)}`}
          title={`${cell.date}: ${cell.count} 次贡献`}
        />
      ))}
    </div>
  ))}
 
  <!-- 统计信息 -->
  <div class="col-span-7 mt-2 flex items-center justify-between text-xs text-slate-500">
    <div class="flex items-center gap-1">
      <span>Less</span>
      {[0, 1, 2, 3, 4].map((level) => (
        <div
          class={`h-3 w-3 rounded-sm ${getHeatClass(level)}`}
        />
      ))}
      <span>More</span>
    </div>
    <div>
      <span class="font-medium text-slate-700">{contribution.total}</span>
      <span> 次贡献</span>
    </div>
  </div>
</div>
