---
// 分区导航：从文章树读取一级目录及其子树文章数。
import SectionHeader from '@/components/layout/SectionHeader.astro'
import ViewAllButton from '@/components/layout/ViewAllButton.astro'
import { getAllPosts } from '@/lib/utils/posts'
import { getSectionName } from '@/lib/utils/section-names'
import { getTopSections } from '@/lib/utils/tree'

const sections = getTopSections(await getAllPosts())

// 无分区时隐藏整个章节
if (sections.length === 0) return null
---

<section data-section="sections" aria-labelledby="sections-title" class="py-16 w-full">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex items-end justify-between mb-8">
      <SectionHeader id="sections-title" title="分区导航" subtitle="按笔记目录浏览" align="left"
        index="04"
        eyebrow="Browse" />
      <ViewAllButton href="/archive" label="查看目录树" />
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {
        sections.map((section) => {
          const name = getSectionName(section.name)
          return (
            <a
              href={`/articles/${encodeURIComponent(section.slugPath)}`}
              class="group block rounded-md border border-border bg-card-background p-5 transition-colors hover:border-ink hover:shadow-hard-hover"
            >
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-lg font-semibold text-foreground">{name}</h3>
                <span
                  class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-accent text-ink-solid text-sm font-bold"
                >
                  {name.slice(0, 1).toUpperCase()}
                </span>
              </div>

              <p class="text-xs text-muted mt-2">{section.postCount} 篇文章</p>
            </a>
          )
        })
      }
    </div>
  </div>
</section>
