---
// BusinessCard.astro
// 个人名片（编辑部）：头像 + 名字 + 一句话 + 邮箱
// 注：GitHub/Gitee 按钮已移至下方 GitHub 展示区，避免重复信息

import Card from '@/components/layout/Card.astro'
import Avatar from '@/components/content/Avatar.astro'
---

<Card padding="p-8">
  <div class="flex flex-col items-center gap-4 text-center">
    <div class="size-28 overflow-hidden rounded-full border border-border">
      <Avatar src="/imgs/avatar.jpg" width={112} height={112} />
    </div>

    <div class="space-y-1">
      <h3 class="font-display text-2xl font-bold">Azuxa616</h3>
      <p class="text-sm text-muted">全栈开发者 · 技术写作</p>
    </div>

    <a class="chip inline-flex items-center gap-2 px-3 py-1 text-sm" href="mailto:2226123739@qq.com">
      <img src="/svgs/email.svg" alt="邮箱" width={16} height={16} />
      2226123739@qq.com
    </a>
  </div>
</Card>
