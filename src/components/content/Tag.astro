---
// Tag.astro
// 标签组件（Neo-Brutalism）
// 统一的描边 + 轻硬阴影 + 悬停位移

interface Props {
  /** 标签文本 */
  label: string
  /** 背景颜色（保留兼容，默认使用卡片底色） */
  bgColor?: string
  /** 文本颜色（保留兼容，默认使用前景色） */
  textColor?: string
  /** 尺寸：小号（封面用）/ 中号（详情页用） */
  size?: 'sm' | 'md'
  /** 额外的 CSS 类名 */
  class?: string
}

const {
  label,
  bgColor = '',
  textColor,
  size = 'md',
  class: className = '',
} = Astro.props

const sizeClasses = {
  sm: 'text-xs px-3 py-1',
  md: 'text-sm px-4 py-1.5',
}
---

<span
  class:list={[
    'inline-flex items-center chip font-semibold text-foreground',
    'cursor-default select-none',
    sizeClasses[size],
    className,
  ]}
>
  <span>#{label}</span>
</span>
