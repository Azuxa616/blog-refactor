---
// ArticleCoverImage.astro
// 文章封面图片组件（编辑部化：展示字体标题 + Neo 元数据芯片）
// 用于显示文章详情页的封面图片和元数据

interface Props {
  /** 封面图片 URL */
  coverImage?: string
  /** 文章标题 */
  title: string
  /** 文章描述 */
  description?: string
  /** 发布日期 */
  publishDate: Date
  /** 更新日期（可选） */
  updatedDate?: Date
}

const { coverImage, title, description, publishDate, updatedDate } = Astro.props

// 有封面图时，文字叠加在深色渐变上，使用白色；
// 无封面图时，背景为页面底色，需使用主题前景色，避免浅色模式下白字不可读。
const titleClass = coverImage ? 'text-white' : 'text-foreground'
const descriptionClass = coverImage ? 'text-white/80' : 'text-muted'
const metaClass = coverImage ? 'text-white/90' : 'text-foreground/90'
---

<header class="relative h-96 overflow-hidden border-b-2 border-ink">
  {
    coverImage && (
      <div class="absolute inset-0">
        <img src={coverImage} alt={title} class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/50 to-ink-solid/80" />
      </div>
    )
  }
  <div
    class="relative z-10 h-full flex flex-col items-center justify-center text-center px-4"
  >
    <h1 class={`font-display text-3xl md:text-5xl font-bold mb-4 leading-tight tracking-tight ${titleClass}`}>
      {title}
    </h1>
    {
      description && (
        <p class={`text-base md:text-lg mb-6 max-w-2xl ${descriptionClass}`}>
          {description}
        </p>
      )
    }
    <div class={`flex flex-wrap items-center justify-center gap-4 text-sm ${metaClass}`}>
      <span class="flex items-center gap-1.5">
        <img
          src="/svgs/calendar.svg"
          width="14"
          height="14"
          alt="发布日期"
          loading="eager"
        />
        {
          updatedDate ? (
            <span>· 更新于 {updatedDate.toLocaleDateString('zh-CN')}</span>
          ) : (
            <span>{publishDate.toLocaleDateString('zh-CN')}</span>
          )
        }
      </span>
    </div>
  </div>
</header>
