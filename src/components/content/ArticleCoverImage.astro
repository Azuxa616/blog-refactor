---
// ArticleCoverImage.astro
// 文章封面图片组件
// 用于显示文章详情页的封面图片和元数据

import Tag from '@/components/content/Tag.astro'
import CategoryBadge from '@/components/content/CategoryBadge.astro'

interface Props {
  /** 封面图片 URL */
  coverImage?: string
  /** 文章标题 */
  title: string
  /** 文章描述 */
  description?: string
  /** 发布日期 */
  publishDate: Date
  /** 更新日期（可选） */
  updatedDate?: Date
  /** 文章分类 */
  category?: string
  /** 文章标签 */
  tags?: string[]
}

const {
  coverImage,
  title,
  description,
  publishDate,
  updatedDate,
  category,
  tags,
} = Astro.props
---

<header class="relative h-96 overflow-hidden">
  {
    coverImage && (
      <div class="absolute inset-0">
        <img src={coverImage} alt={title} class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/60 to-black/80" />
      </div>
    )
  }
  <div
    class="relative z-10 h-full flex flex-col items-center justify-center text-center px-4"
  >
    <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">
      {title}
    </h1>
    {
      description && (
        <p class="text-base md:text-lg text-white/80 mb-6 max-w-2xl">
          {description}
        </p>
      )
    }
    <div
      class="flex flex-wrap items-center justify-center gap-4 text-white/90 text-sm"
    >
      {
        category && (
          <>
            <CategoryBadge title={category} color="#ffffff" />
            <span class="text-white/40">|</span>
          </>
        )
      }
      <span class="flex items-center gap-1.5">
        <img
          src="/svgs/calendar.svg"
          width="14"
          height="14"
          alt="发布日期"
          loading="eager"
        />
        {
          updatedDate ? (
            <span>· 更新于 {updatedDate.toLocaleDateString('zh-CN')}</span>
          ) : (
            <span>{publishDate.toLocaleDateString('zh-CN')}</span>
          )
        }
      </span>
      {
        tags && tags.length > 0 && (
          <>
            <span class="text-white/40">|</span>
            <div class="flex flex-wrap items-center justify-center gap-2">
              {tags.map((tag) => (
                <Tag label={tag} bgColor="#ffffff" size="sm" />
              ))}
            </div>
          </>
        )
      }
    </div>
  </div>
</header>
