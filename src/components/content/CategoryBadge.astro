---
// CategoryBadge.astro
// 分类徽章组件（Neo-Brutalism）
// 描边芯片 + 色块，统一可读

interface Props {
  /** 分类标题 */
  title: string
  /** 图标（SVG 路径字符串，如 "/svgs/calendar.svg"） */
  icon?: string
  /** 背景颜色（16进制，如 "#ffffff"），默认 "#D64550" */
  color?: string
  /** 额外的 CSS 类名 */
  class?: string
}

const { title, icon, color = '#D64550', class: className = '' } = Astro.props
---

<span
  class:list={[
    'inline-flex items-center gap-2 chip px-3 py-1',
    'text-sm font-semibold text-foreground',
    'select-none',
    className,
  ]}
>
  {
    icon && (
      <img
        src={icon}
        alt={title}
        width="14"
        height="14"
        loading="eager"
        class="opacity-90"
      />
    )
  }
  <span class="h-2.5 w-2.5" style={`background-color: ${color}`}></span>
  <span>{title}</span>
</span>
