---
import { stripMarkdown } from '@/lib/utils/markdown'
// 博客文章卡片组件（Neo-Brutalism）
// 使用 Alpine.js 处理图片加载错误

interface Props {
  /** 封面图片 URL */
  coverImage?: string
  /** 文章标题 */
  title?: string
  /** 文章描述 */
  description?: string
  /** 所属一级分区名称 */
  section?: string
  /** 发布日期 */
  publishDate?: string
  /** 浏览次数 */
  viewCount?: number
  /** 额外的 CSS 类名 */
  className?: string
}

const {
  coverImage = "",
  title = "Untitled",
  description = "No description",
  section = '其他',
  publishDate = "未知时间",
  viewCount = 0,
  className = ""
} = Astro.props
---

<div
  class={`neo min-h-60 bg-card-background flex flex-col sm:flex-row justify-between items-center gap-4 ${className}`}
>
  <!-- 封面图片 -->
  <div class="w-full sm:w-1/3 sm:h-60 overflow-hidden relative rounded-sm">
    {
      coverImage ? (
        <>
          <div
            class="absolute inset-0 bg-cover bg-center"
            style={`background-image: url(${coverImage})`}
          />
          <img src={coverImage} alt={title} class="w-full h-full opacity-0" />
        </>
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-ink-solid">
          <span class="font-display text-6xl font-bold text-paper/20">{(title || 'A').charAt(0)}</span>
        </div>
      )
    }
  </div>

  <!-- 文章信息 -->
  <div class="flex flex-col flex-1 gap-3 justify-center items-start h-full w-full sm:w-auto px-4 sm:px-0 sm:mx-5 py-4 sm:py-0">
    <!-- 标题和分区 -->
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-2xl font-bold text-foreground line-clamp-2 flex-1 leading-tight">
        {title}
      </h3>
      <span
        class="inline-flex flex-shrink-0 items-center gap-1.5 chip px-2 py-1 text-xs font-semibold"
      >
        <span class="h-2.5 w-2.5 bg-primary"></span>
        {section}
      </span>
    </div>

    <!-- 描述 -->
    <p class="text-start text-muted text-sm line-clamp-2 leading-relaxed">
      {stripMarkdown(description)}
    </p>

    <!-- 底部信息 -->
    <div class="flex items-center gap-3 text-xs text-muted mt-auto">
      <span class="flex items-center gap-1">
        <img src="/svgs/calendar.svg" width="12" height="12" alt="日期" />
        {publishDate}
      </span>
      {viewCount > 0 && (
        <span class="flex items-center gap-1">
          <img src="/svgs/eye.svg" width="12" height="12" alt="浏览次数" />
          {viewCount}
        </span>
      )}
    </div>
  </div>
</div>
