---
// SkillsCard.astro
// 技能卡片组件
// 展示技能熟练度卡片，包含已掌握和学习中的技术列表
// 每个技能显示名称、熟练度仪表盘和文档链接
// 注意：已将原本的 window.open() 调用改为标准的 <a> 标签

import Card from '@/components/layout/Card.astro'

interface Skill {
  name: string
  proficiency: number
  imgUrl?: string
  docUrl?: string
}

interface Props {
  /** 已掌握的技能列表 */
  learned: Skill[]
  /** 学习中的技能列表 */
  practicing: Skill[]
}

const { learned, practicing } = Astro.props

// 构建仪表盘样式的辅助函数
// 使用 conic-gradient 创建环形进度条效果
const buildGaugeStyle = (value: number, color: string) => {
  const safeValue = Math.max(6, Math.min(100, value))
  return {
    background: `conic-gradient(${color} ${safeValue * 3.6}deg, rgba(148, 163, 184, 0.2) 0deg)`,
  }
}

// 主题配色预设
const tonePresets = {
  mastery: {
    gaugeColor: '#34d399',
    glowClass: 'shadow-[0_15px_35px_-15px_rgba(16,185,129,0.7)]',
    backgroundClass: 'from-emerald-50/80 via-white/70 to-teal-50/70',
  },
  growth: {
    gaugeColor: '#fb923c',
    glowClass: 'shadow-[0_15px_35px_-15px_rgba(251,146,60,0.65)]',
    backgroundClass: 'from-amber-50/80 via-white/70 to-orange-50/70',
  },
}

// 计算所有技能的平均熟练度
const totalSkills = learned.length + practicing.length
const _averageProficiency =
  totalSkills === 0
    ? 0
    : Math.round(
        [...learned, ...practicing].reduce(
          (sum, skill) => sum + skill.proficiency,
          0,
        ) / totalSkills,
      )
---

<div class="relative w-full overflow-hidden rounded-2xl">
  <Card class="relative w-full overflow-hidden">
    <div
      class="pointer-events-none absolute -right-32 top-0 h-64 w-64 rounded-full blur-[140px] bg-blue-100"
    >
    </div>
    <div class="flex w-full flex-col gap-8">
      <header class="space-y-3 text-center">
        <p class="text-xs uppercase tracking-[0.4em]">Skill Orbit</p>
        <h2 class="text-3xl font-semibold">技术力雷达</h2>
      </header>

      <!-- 已掌握的技术部分 -->
      {
        learned.length > 0 && (
          <section class="space-y-4">
            <div class="flex gap-2">
              <span class="font-serif font-bold text-5xl text-[#34d399]">
                S
              </span>
              <div class="flex flex-col items-start text-sm font-semibold">
                <p class="text-xl text-[#34d399]">tack</p>
                <p class="text-xs font-normal text-slate-500">已掌握的技术</p>
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              {learned.map((skill, _index) => {
                const preset = tonePresets.mastery
                const gaugeStyle = buildGaugeStyle(
                  skill.proficiency,
                  preset.gaugeColor,
                )

                return (
                  <div
                    class={`group relative overflow-hidden flex items-center justify-between gap-4 rounded-2xl border border-white/40 bg-gradient-to-br ${preset.backgroundClass} p-4 transition-all duration-300 hover:-translate-y-1 hover:border-slate-200/70 hover:shadow-xl ${preset.glowClass}`}
                  >
                    <div class="absolute inset-0 mt-15 z-0 flex items-center justify-start opacity-30">
                      {skill.imgUrl && (
                        <img
                          src={skill.imgUrl}
                          alt={skill.name}
                          width={200}
                          height={300}
                        />
                      )}
                    </div>
                    <div class="relative z-10 flex items-start justify-between gap-3">
                      {skill.docUrl ? (
                        <a
                          href={skill.docUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-3"
                        >
                          <p class="font-bold text-2xl">{skill.name}</p>
                        </a>
                      ) : (
                        <p class="font-bold text-2xl">{skill.name}</p>
                      )}
                    </div>
                    <div class="relative z-10 flex items-center gap-4 h-16 w-16">
                      <div
                        class="absolute inset-0 rounded-full border"
                        style={gaugeStyle}
                      />
                      <div class="absolute inset-1 flex flex-col items-center justify-center rounded-full text-center text-xl font-semibold bg-gray-100">
                        {skill.proficiency}%
                      </div>
                    </div>
                  </div>
                )
              })}
            </div>
          </section>
        )
      }

      <!-- 学习中的技术部分 -->
      {
        practicing.length > 0 && (
          <section class="space-y-4">
            <div class="flex gap-2">
              <span class="font-serif font-bold text-5xl text-[#fb923c]">
                Q
              </span>
              <div class="flex flex-col items-start text-sm font-semibold">
                <p class="text-xl text-[#fb923c]">ueue</p>
                <p class="text-xs font-normal text-slate-500">学习中的技术</p>
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              {practicing.map((skill, _index) => {
                const preset = tonePresets.growth
                const gaugeStyle = buildGaugeStyle(
                  skill.proficiency,
                  preset.gaugeColor,
                )

                return (
                  <div
                    class={`group relative overflow-hidden flex items-center justify-between gap-4 rounded-2xl border border-white/40 bg-gradient-to-br ${preset.backgroundClass} p-4 transition-all duration-300 hover:-translate-y-1 hover:border-slate-200/70 hover:shadow-xl ${preset.glowClass}`}
                  >
                    <div class="absolute inset-0 mt-15 z-0 flex items-center justify-start opacity-30">
                      {skill.imgUrl && (
                        <img
                          src={skill.imgUrl}
                          alt={skill.name}
                          width={200}
                          height={300}
                        />
                      )}
                    </div>
                    <div class="relative z-10 flex items-start justify-between gap-3">
                      {skill.docUrl ? (
                        <a
                          href={skill.docUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-3"
                        >
                          <p class="font-bold text-2xl">{skill.name}</p>
                        </a>
                      ) : (
                        <p class="font-bold text-2xl">{skill.name}</p>
                      )}
                    </div>
                    <div class="relative z-10 flex items-center gap-4 h-16 w-16">
                      <div
                        class="absolute inset-0 rounded-full border"
                        style={gaugeStyle}
                      />
                      <div class="absolute inset-1 flex flex-col items-center justify-center rounded-full text-center text-xl font-semibold bg-gray-100">
                        {skill.proficiency}%
                      </div>
                    </div>
                  </div>
                )
              })}
            </div>
          </section>
        )
      }
    </div>
  </Card>
</div>
