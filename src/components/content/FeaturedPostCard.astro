---
import { stripMarkdown } from '@/lib/utils/markdown'
// FeaturedPostCard.astro
// 首页特色文章卡片 - 大尺寸高亮展示单篇最新文章（Neo-Brutalism）

import CategoryBadge from '@/components/content/CategoryBadge.astro'

interface Props {
  /** 文章 slug */
  slug: string
  /** 文章标题 */
  title: string
  /** 文章描述 */
  description: string
  /** 封面图片 URL */
  coverImage?: string
  /** 发布日期 */
  publishDate: string
  /** 分类信息 */
  category?: {
    name: string
    color?: string
  }
}

const {
  slug,
  title,
  description,
  coverImage,
  publishDate,
  category,
} = Astro.props
---

<a href={`/articles/${slug}`} class="block w-full">
  <div class="neo min-h-80 md:min-h-96 bg-card-background overflow-hidden flex flex-col md:flex-row">
    <!-- 封面图片区域 (左侧 60%) -->
    <div class="w-full md:w-3/5 min-h-48 md:min-h-0 relative overflow-hidden">
      {
        coverImage ? (
          <>
            <div
              class="absolute inset-0 bg-cover bg-center"
              style={`background-image: url(${coverImage})`}
            />
            <img
              src={coverImage}
              alt={title}
              class="w-full h-full opacity-0"
            />
          </>
        ) : (
          <div class="absolute inset-0 flex items-center justify-center bg-ink-solid">
            <span class="font-display text-7xl font-bold text-paper/20">{title.charAt(0)}</span>
          </div>
        )
      }
    </div>

    <!-- 文本内容区域 (右侧 40%) -->
    <div class="w-full md:w-2/5 p-6 flex flex-col gap-4 bg-card-background">
      <!-- 分类徽章 -->
      {
        category && (
          <CategoryBadge
            title={category.name}
            color={category.color}
          />
        )
      }

      <!-- 标题 -->
      <h3 class="font-display text-2xl md:text-3xl font-bold text-foreground line-clamp-2 leading-tight">
        {title}
      </h3>

      <!-- 描述 -->
      <p class="text-muted text-sm md:text-base line-clamp-3 leading-relaxed flex-1">
        {stripMarkdown(description)}
      </p>

      <!-- 底部信息 -->
      <div class="flex items-center justify-between gap-3 text-sm text-muted mt-auto">
        <span class="flex items-center gap-1.5">
          <img
            src="/svgs/calendar.svg"
            width="14"
            height="14"
            alt="日期"
            loading="eager"
          />
          {publishDate}
        </span>
        <span class="font-medium text-primary flex items-center gap-1">
          阅读全文
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform group-hover:translate-x-1"
          >
            <path d="M5 12h14" />
            <path d="M12 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>
  </div>
</a>
