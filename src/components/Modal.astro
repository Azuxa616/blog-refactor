---
// 模态框组件
// 使用 Alpine.js 管理打开/关闭状态
// 添加中文注释

interface Props {
  /** 是否打开 */
  isOpen?: boolean
  /** 关闭回调函数 */
  onClose?: () => void
  /** 标题 */
  title?: string
  /** 尺寸 */
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  /** 是否显示关闭按钮 */
  showCloseButton?: boolean
  /** 额外的 CSS 类名 */
  className?: string
}

const { 
  isOpen = false, 
  title, 
  size = 'md', 
  showCloseButton = true,
  className = ''
} = Astro.props

const sizeClasses = {
  sm: 'w-96',
  md: 'w-[500px]',
  lg: 'w-[700px]',
  xl: 'w-[900px]',
  full: 'w-[95vw] max-w-[1200px]',
}
---

<div 
  x-data="{ open: ${isOpen} }"
  x-show="open"
  @keydown.escape.window="open = false"
  class="fixed inset-0 bg-[#5252523c] bg-opacity-60 overflow-y-auto h-full w-full z-50"
  @click.self="open = false"
  x-cloak
>
  <div 
    class="relative top-20 mx-auto p-5 border shadow-lg rounded-md bg-white"
    :class="`${sizeClasses['${size}']} ${className}`"
    @click.stop
  >
    <div class="mt-3">
      <div x-show="${title || showCloseButton}" class="flex items-center justify-between mb-4">
        <h3 x-show="${title}" class="text-lg font-medium text-gray-900">${title}</h3>
        <button 
          x-show="${showCloseButton}"
          @click="open = false"
          class="text-gray-400 hover:text-gray-600 transition-colors"
          aria-label="关闭"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <slot />
    </div>
  </div>
</div>

<script>
  // 模态框打开/关闭时锁定/解锁滚动
  document.addEventListener('alpine:init', () => {
    Alpine.effect(() => {
      const modalEl = document.querySelector('[x-data]')
      if (modalEl) {
        const open = Alpine.$data(modalEl)?.open
        document.body.style.overflow = open ? 'hidden' : ''
      }
    })
  })
</script>
