---
// 模态框组件
// 使用 Alpine.js 管理打开/关闭状态
// 添加中文注释

interface Props {
  /** 是否打开 */
  isOpen?: boolean
  /** 关闭回调函数 */
  onClose?: () => void
  /** 标题 */
  title?: string
  /** 尺寸 */
  _size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  /** 是否显示关闭按钮 */
  showCloseButton?: boolean
  /** 额外的 CSS 类名 */
  _className?: string
}

const {
  isOpen = false,
  title,
  _size = 'md',
  showCloseButton = true,
  _className = ''
} = Astro.props

const _sizeClasses = {
  sm: 'w-96',
  md: 'w-[500px]',
  lg: 'w-[700px]',
  xl: 'w-[900px]',
  full: 'w-[95vw] max-w-[1200px]',
}
---

<div 
  x-data={`{ 
    open: ${isOpen},
    title: ${JSON.stringify(title || '')},
    showHeader: ${!!(title || showCloseButton)},
    showTitle: ${!title},
    showClose: ${!showCloseButton}
  }`}
  x-show="open"
  @keydown.escape.window="open = false"
  class="fixed inset-0 bg-[#5252523c] bg-opacity-60 overflow-y-auto h-full w-full z-50"
  @click.self="open = false"
  x-cloak
>
  <div 
    class="relative top-20 mx-auto p-5 border shadow-lg rounded-md bg-white ${_sizeClasses[_size]} ${_className}"
    @click.stop
  >
    <div class="mt-3">
      <div x-show="showHeader" class="flex items-center justify-between mb-4">
        <h3 x-show="title" class="text-lg font-medium text-gray-900" x-text="title"></h3>
        <button
          x-show="showClose"
          @click="open = false"
          class="text-gray-400 hover:text-gray-600 transition-colors"
          aria-label="关闭"
        >
          <img src="/svgs/close.svg" width="24" height="24" alt="关闭" />
        </button>
      </div>
      <slot />
    </div>
  </div>
</div>

