---
// SkeletonCard.astro
// 骨架卡片组件
// 用于创建卡片加载占位，包含可选的头部和底部占位

import SkeletonBox from './SkeletonBox.astro'
import SkeletonText from './SkeletonText.astro'
import SkeletonAvatar from './SkeletonAvatar.astro'

interface Props {
  /** 额外的 CSS 类名 */
  className?: string
  /** 是否显示头部占位，默认 true */
  showHeader?: boolean
  /** 是否显示底部占位，默认 false */
  showFooter?: boolean
  /** 中间内容行数，默认 3 */
  lines?: number
}

const {
  className = "",
  showHeader = true,
  showFooter = false,
  lines = 3,
} = Astro.props
---

<div class={`rounded-2xl border border-slate-100/70 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/80 ${className}`}>
  {showHeader && (
    <div class="mb-4 flex items-center justify-between">
      <SkeletonText width="w-32" height="h-5" />
      <SkeletonText width="w-16" height="h-3" />
    </div>
  )}
  <div class="space-y-2">
    <SkeletonText lines={lines} />
  </div>
  {showFooter && (
    <div class="mt-4 flex items-center justify-between">
      <SkeletonAvatar size="sm" />
      <SkeletonText width="w-24" height="h-3" />
    </div>
  )}
</div>
