---
// GitHub 展示区组件
// 用于显示 GitHub 用户信息和仓库列表
// 添加中文注释

import GithubCard from './github/GithubCard.astro'
import { githubData } from '../data/github'

interface Props {
  /** GitHub 数据 */
  data?: typeof githubData
  /** 是否加载中 */
  isLoading?: boolean
  /** 错误信息 */
  error?: string | null
}

const {
  data = githubData,
  isLoading = false,
  error = null
} = Astro.props
---

<div class="relative flex items-start justify-center w-full text-center gap-8 bg-background">
  <GithubCard
    user={data?.user || githubData.user}
    repos={data?.repos || githubData.repos}
    learned={data?.skills?.learned || githubData.skills.learned}
    practicing={data?.skills?.practicing || githubData.skills.practicing}
    isLoading={isLoading}
    error={error}
  />
</div>
