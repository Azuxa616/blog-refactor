---
// 博客文章卡片组件
// 使用 Alpine.js 处理图片加载错误
// 添加中文注释

interface Props {
  /** 封面图片 URL */
  coverImage?: string
  /** 文章标题 */
  title?: string
  /** 文章描述 */
  description?: string
  /** 分类信息 */
  category?: {
    name: string
    color?: string
  }
  /** 发布日期 */
  publishDate?: string
  /** 浏览次数 */
  viewCount?: number
  /** 额外的 CSS 类名 */
  className?: string
}

const {
  coverImage = "",
  title = "Untitled",
  description = "No description",
  category = { name: "未分类", color: "#254889" },
  publishDate = "未知时间",
  viewCount = 0,
  className = ""
} = Astro.props

const fallbackSrc = '/imgs/404.jpg'
---

<div 
  class={`min-h-60 bg-card-background backdrop-blur-sm border border-white/20 shadow-xl rounded-2xl hover:shadow-2xl transition-all duration-300 flex min-w-96 justify-between items-center gap-4 ${className}`}
>
  <!-- 封面图片 -->
  <div x-data={`imageFallback()`} x-init={`init('${coverImage || fallbackSrc}', '${fallbackSrc}')`} class="w-1/3 h-60 overflow-hidden relative rounded-lg">
    <img
      :src="currentSrc"
      alt={title}
      class="absolute inset-0 w-full h-full object-cover"
      @error="handleError"
    />
  </div>

  <!-- 文章信息 -->
  <div class="flex flex-col flex-1 gap-3 justify-center items-start h-full mx-5">
    <!-- 标题和分类 -->
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-2xl font-bold text-foreground line-clamp-2 flex-1 leading-tight">
        {title}
      </h3>
      <span 
        class="flex-shrink-0 px-2 py-1 text-white text-xs font-medium rounded-full"
        style={`background-color: ${category.color || "#254889"}`}
      >
        {category.name}
      </span>
    </div>

    <!-- 描述 -->
    <p class="text-start text-muted text-sm line-clamp-2 leading-relaxed">
      {description}
    </p>

    <!-- 底部信息 -->
    <div class="flex items-center gap-3 text-xs text-muted mt-auto">
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {publishDate}
      </span>
      {viewCount > 0 && (
        <span class="flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          {viewCount}
        </span>
      )}
    </div>
  </div>
</div>
