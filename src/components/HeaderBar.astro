---
// 头部导航栏组件
// 使用 Alpine.js 管理展开/收起状态和样式切换
// 添加中文注释

import NavLinkButton from './NavLinkButton.astro'

interface Props {
  /** 是否使用展开状态切换 */
  isUseSwitch?: boolean
  /** 额外的 CSS 类名 */
  _className?: string
}

// @ts-ignore - className is used in template
const { isUseSwitch = true, _className = '' } = Astro.props

const menuItems = [
  { href: '/', label: '首页' },
  { href: '/articles', label: '文章' },
  { href: '/about', label: '关于' },
  { href: '/links', label: '友链' },
]
---

<div
  x-data={`{
    isExpanded: false,
    useSwitch: ${isUseSwitch ? 'true' : 'false'},
    init() {
      console.log('[HeaderBar] Alpine.js initialized')
      console.log('[HeaderBar] useSwitch:', this.useSwitch)
      console.log('[HeaderBar] $store.appState:', $store.appState)
      console.log('[HeaderBar] $store.appState.isExpanded:', $store.appState?.isExpanded)
      this.isExpanded = $store.appState?.isExpanded || false
    },
    toggleExpanded() {
      this.isExpanded = !this.isExpanded
      $store.appState.isExpanded = this.isExpanded
    }
  }`}
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-start w-full h-16 border px-8 gap-10 transition-colors duration-300"
  :class="isExpanded || !useSwitch ? 'bg-white/60 backdrop-blur-sm text-black dark:text-white border-gray-200' : 'bg-transparent text-white'"
  x-cloak
>
  <div class="text-xl font-bold">Azuxa&apos;s BlogSpace</div>
  <div class="flex items-center gap-4">
    {
      menuItems.map((item) => (
        <NavLinkButton
          href={item.href}
          label={item.label}
          isDarkUnderline={isUseSwitch}
        />
      ))
    }
  </div>
</div>
