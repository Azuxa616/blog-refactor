---
// 打字机效果组件
// 使用 Alpine.js 实现打字机效果

interface Props {
  initialText?: string
  repeatedTextList?: string[]
  initialTypingSpeed?: number
  repeatedTypingSpeed?: number
  gapInterval?: number
  loop?: boolean
  deleteSpeed?: number
  cursor?: string
  cursorBlinkInterval?: number
  className?: string
}

const {
  initialText = '',
  repeatedTextList = [],
  initialTypingSpeed = 100,
  repeatedTypingSpeed = 100,
  gapInterval = 2000,
  loop = true,
  deleteSpeed = 50,
  cursor = '|',
  cursorBlinkInterval = 500,
  className = ''
} = Astro.props
---

<span 
  class={className}
  x-data={`{
    displayedText: '',
    currentIndex: 0,
    isDeleting: false,
    showCursor: true,
    timer: null,
    texts: ${JSON.stringify([initialText, ...repeatedTextList])},
    init() {
      this.cursorInterval = setInterval(() => { this.showCursor = !this.showCursor }, ${cursorBlinkInterval})
      this.typeNext()
    },
    typeNext() {
      const text = this.texts[this.currentIndex]
      if (!this.isDeleting) {
        if (this.displayedText.length < text.length) {
          this.displayedText = text.slice(0, this.displayedText.length + 1)
          this.timer = setTimeout(() => this.typeNext(), ${repeatedTypingSpeed})
        } else {
          this.timer = setTimeout(() => { 
            this.isDeleting = true
            this.typeNext()
          }, ${gapInterval})
        }
      } else {
        if (this.displayedText.length > 0) {
          this.displayedText = this.displayedText.slice(0, -1)
          this.timer = setTimeout(() => this.typeNext(), ${deleteSpeed})
        } else {
          this.isDeleting = false
          this.currentIndex = (this.currentIndex + 1) % this.texts.length
          if (!${loop} && this.currentIndex === 0) {
            clearInterval(this.cursorInterval)
          } else {
            this.timer = setTimeout(() => this.typeNext(), ${gapInterval})
          }
        }
      }
    }
  }`}
>
  <span x-text="displayedText"></span>
  <span x-show="showCursor">|</span>
</span>
