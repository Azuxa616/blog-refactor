---
// 打字机效果组件
// 使用 Alpine.js 实现打字机效果

interface Props {
  textList: string | string[]
  typingSpeed?: number
  deleteSpeed?: number
  gapInterval?: number
  cursorBlinkInterval?: number
  className?: string
}

const {
  textList,
  typingSpeed = 100,
  deleteSpeed = 50,
  gapInterval = 2000,
  cursorBlinkInterval = 500,
  className = ''
} = Astro.props

const texts = Array.isArray(textList) ? textList : [textList]
---

<span 
  class={className}
  x-data={`{
    displayedInitialText: '',
    currentIndex: 0,
    isDeleting: false,
    showCursor: true,
    timer: null,
    texts: ${JSON.stringify(texts)},
    init() {
      this.cursorInterval = setInterval(() => { this.showCursor = !this.showCursor }, ${cursorBlinkInterval})
      this.typeNext()
    },
    typeNext() {
      const text = this.texts[this.currentIndex]
      if (!this.isDeleting) {
        if (this.displayedInitialText.length < text.length) {
          this.displayedInitialText = text.slice(0, this.displayedInitialText.length + 1)
          this.timer = setTimeout(() => this.typeNext(), ${typingSpeed})
        } else {
          this.isDeleting = false
          this.currentIndex = (this.currentIndex + 1) % this.texts.length
          this.timer = setTimeout(() => this.typeNext(), ${gapInterval})
        }
      } else {
        if (this.displayedInitialText.length > 0) {
          this.displayedInitialText = this.displayedInitialText.slice(0, -1)
          this.timer = setTimeout(() => this.typeNext(), ${deleteSpeed})
        } else {
          this.isDeleting = false
          this.currentIndex = (this.currentIndex + 1) % this.texts.length
          this.timer = setTimeout(() => this.typeNext(), ${gapInterval})
        }
      }
    }
  }`}
>
  <span x-text="displayedInitialText"></span>
  <span x-show="showCursor">|</span>
</span>
