---
// GithubUtils.astro
// GitHub 卡片辅助函数
// 提供构建贡献热力图、格式化时间、获取语言颜色等工具函数

interface GitHubRepo {
  id: number
  name: string
  description: string | null
  html_url: string
  updated_at: string
  language: string | null
  license: {
    name: string
    spdx_id: string
  } | null
  stargazers_count: number
}

interface ContributionCell {
  date: string
  count: number
}

interface ContributionSnapshot {
  weeks: ContributionCell[][]
  total: number
  activeDays: number
  currentStreak: number
  longestStreak: number
}

const CONTRIBUTION_DAYS = 42

/**
 * 构建贡献热力图数据
 * 根据仓库的更新时间模拟贡献活动数据
 */
export const buildContributionSnapshot = (repos: GitHubRepo[]): ContributionSnapshot => {
  const today = new Date()
  today.setHours(0, 0, 0, 0)

  const days: ContributionCell[] = Array.from({ length: CONTRIBUTION_DAYS }, (_, index) => {
    const date = new Date(today)
    date.setDate(today.getDate() - (CONTRIBUTION_DAYS - 1 - index))
    return { date: date.toISOString().split("T")[0], count: 0 }
  })

  const dayMap = new Map(days.map((item) => [item.date, item]))

  repos.forEach((repo) => {
    const updated = new Date(repo.updated_at)
    updated.setHours(0, 0, 0, 0)
    const key = updated.toISOString().split("T")[0]
    const slot = dayMap.get(key)

    if (slot) {
      // 根据描述长度计算权重，描述越长权重越高
      const weight = 1 + Math.min(3, Math.floor((repo.description?.length || repo.name.length) / 40))
      slot.count += weight
    }
  })

  const counts = days.map((day) => day.count)
  const total = counts.reduce((sum, count) => sum + count, 0)
  const activeDays = counts.filter((count) => count > 0).length

  // 计算最长连续活跃天数
  let longestStreak = 0
  let rollingStreak = 0
  counts.forEach((count) => {
    if (count > 0) {
      rollingStreak += 1
      longestStreak = Math.max(longestStreak, rollingStreak)
    } else {
      rollingStreak = 0
    }
  })

  // 计算当前连续活跃天数（从今天向前）
  let currentStreak = 0
  for (let i = counts.length - 1; i >= 0; i -= 1) {
    if (counts[i] > 0) {
      currentStreak += 1
    } else {
      break
    }
  }

  // 按周分组数据
  const weeks: ContributionCell[][] = []
  for (let i = 0; i < days.length; i += 7) {
    weeks.push(days.slice(i, i + 7))
  }

  return {
    weeks,
    total,
    activeDays,
    currentStreak,
    longestStreak,
  }
}

/**
 * 根据贡献值获取热力图颜色类
 */
export const getHeatClass = (value: number): string => {
  if (value === 0) return "bg-slate-200/70"
  if (value === 1) return "bg-emerald-200/80"
  if (value === 2) return "bg-emerald-300/80"
  if (value === 3) return "bg-emerald-500/80"
  return "bg-emerald-600"
}

/**
 * 格式化相对时间
 * 将 ISO 日期字符串转换为"X天前"等相对时间格式
 */
export const formatRelativeTime = (isoDate: string): string => {
  const date = new Date(isoDate)
  const diff = Date.now() - date.getTime()

  const units = [
    { label: "年", value: 1000 * 60 * 60 * 24 * 365 },
    { label: "月", value: 1000 * 60 * 60 * 24 * 30 },
    { label: "天", value: 1000 * 60 * 60 * 24 },
    { label: "小时", value: 1000 * 60 * 60 },
    { label: "分钟", value: 1000 * 60 },
  ]

  for (const unit of units) {
    if (diff >= unit.value) {
      const count = Math.floor(diff / unit.value)
      return `${count}${unit.label}前`
    }
  }

  return "刚刚更新"
}

/**
 * 根据编程语言获取颜色类
 */
export const getLanguageColor = (language: string | null): string => {
  if (!language) return "bg-gray-500"

  const colors: Record<string, string> = {
    JavaScript: "bg-yellow-400",
    TypeScript: "bg-blue-500",
    Python: "bg-blue-600",
    Java: "bg-orange-500",
    "C++": "bg-blue-700",
    C: "bg-gray-600",
    "C#": "bg-purple-600",
    Go: "bg-cyan-500",
    Rust: "bg-orange-600",
    PHP: "bg-indigo-500",
    Ruby: "bg-red-500",
    Swift: "bg-orange-400",
    Kotlin: "bg-purple-500",
    HTML: "bg-orange-500",
    CSS: "bg-blue-500",
    Vue: "bg-green-500",
    React: "bg-cyan-400",
    Shell: "bg-gray-400",
    Dockerfile: "bg-blue-400",
  }

  return colors[language] || "bg-gray-500"
}
