---
// CategoryCard.astro
// 分类卡片组件
// 展示分类信息，支持拖放上传 Markdown 文件和点击展开
// 使用 Alpine.js 替代 React 的 useState 和事件处理

interface Category {
  id: string
  name: string
  slug: string
  description: string
  color?: string
  articleCount: number
  createdAt: string
  updatedAt: string
}

interface Props {
  /** 分类对象 */
  category: Category
  /** 用于动画延迟的索引 */
  index: number
  /** 展开分类的回调函数 */
  onExpand: (categoryId: string) => void
  /** 文件拖放上传的回调函数 */
  onFileDrop?: (file: File, categoryId: string) => void
}

const { category, index, onExpand, onFileDrop } = Astro.props
const accentColor = category.color || '#2563eb'

// 将 onFileDrop 函数转换为全局可访问的函数，供 Alpine.js 调用
// 注意：这种方式在实际使用中需要确保 onFileDrop 函数可用
// 在 Alpine 组件中可以通过 window 对象访问
const fileDropHandlerName = `handleFileDrop_${category.id}`
const fileDropHandlerScript = `
  window.${fileDropHandlerName} = async function(files) {
    if (!files || files.length === 0) return
    const file = files[0]
    if (!file.name.toLowerCase().endsWith('.md')) {
      alert('只能上传Markdown文件（.md格式）')
      return
    }
    ${onFileDrop ? `await window.handleFileDropCallback(file, '${category.id}')` : ''}
  }
  ${onFileDrop ? `window.handleFileDropCallback = ${onFileDrop.toString()}` : ''}
`
---

<div
  x-data="{
    isDraggingOver: false,
    handleDragOver() { this.isDraggingOver = true },
    handleDragLeave() { this.isDraggingOver = false },
    async handleDrop(event) {
      this.isDraggingOver = false
      const files = event.dataTransfer?.files
      if (files && files.length > 0) {
        window.${fileDropHandlerName}(files)
      }
    }
  }"
  @click={() => onExpand(category.id)}
  @dragover="handleDragOver"
  @dragleave="handleDragLeave"
  @drop="handleDrop"
  class:list={[
    'rounded-3xl border border-slate-100/80 bg-white/95 p-6 shadow-lg shadow-slate-900/5',
    'transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[var(--admin-primary)]/50',
    'hover:shadow-2xl active:scale-[0.99] slide-in-from-bottom-4',
    'ring-4 ring-[var(--admin-primary)]/40 ring-offset-2'
  ]}
  style:animation-delay={`${index * 50}ms`}
  style:animation-fill-mode="both"
  style:border-color="isDraggingOver ? accentColor : undefined"
>
  <div class="group relative text-slate-900">
    <!-- 拖放状态遮罩 -->
    <div
      x-show="isDraggingOver"
      x-transition
      class="absolute inset-0 z-10 flex items-center justify-center rounded-3xl bg-black/20"
    >
      <div class="text-center">
        <img src="/svgs/upload.svg" width="48" height="48" class="mx-auto mb-2 animate-bounce" alt="上传" />
        <p class="text-lg font-semibold text-white">松开以上传</p>
      </div>
    </div>

    <!-- 分类内容 -->
    <div class="flex items-start justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Category</p>
        <h3 class="mt-2 text-xl font-semibold transition-transform duration-200 group-hover:translate-x-1">
          {category.name}
        </h3>
      </div>
      <span
        class="inline-flex h-10 w-10 items-center justify-center rounded-2xl text-white"
        style={`background: linear-gradient(135deg, ${accentColor}, #0f172a)`}
      >
        {category.name.slice(0, 1).toUpperCase()}
      </span>
    </div>
    <p class="mt-3 line-clamp-2 text-sm text-slate-500 transition-opacity duration-200 group-hover:text-slate-600">
      {category.description || '暂无描述'}
    </p>
    <div class="mt-4 flex items-center justify-between text-sm text-slate-500">
      <span class="font-medium text-slate-700">{category.articleCount} 篇文章</span>
      <img src="/svgs/chevron-right.svg" width="20" height="20" class="text-slate-400 transition-all duration-200 group-hover:text-slate-600 group-hover:translate-x-1" alt="展开" />
    </div>
  </div>
</div>

<!-- 注册文件处理函数 -->
  <script is:inline define:vars={{ fileDropHandlerName, fileDropHandlerScript }}>
  // 在 Alpine.js 初始化时注册文件处理函数
  document.addEventListener('alpine:init', () => {
    const script = document.createElement('script')
    script.textContent = fileDropHandlerScript
    document.head.appendChild(script)
  })
</script>
