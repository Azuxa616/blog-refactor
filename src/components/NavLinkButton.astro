---
// 导航链接按钮组件
// 带有下划线动画效果的导航链接，支持自定义下划线颜色

interface Props {
  /** 链接地址 */
  href: string
  /** 按钮文本 */
  label: string
  /** 是否使用深色下划线（默认为 false，使用浅色下划线） */
  isDarkUnderline?: boolean
  /** 额外的 CSS 类名 */
  className?: string
}

const { href, label, isDarkUnderline = false, className = '' } = Astro.props

const underlineClass = isDarkUnderline
  ? 'nav-link-underline-dark'
  : 'nav-link-underline-light'
---

<a
  href={href}
  class:list={[
    'relative px-4 py-2 transition-colors duration-200 font-semibold nav-link-underline text-inherit',
    underlineClass,
    className,
  ]}
>
  {label}
</a>
