---
// ArticleCoverImage.astro
// 文章封面图片组件
// 用于显示文章详情页的封面图片和元数据

interface Props {
  /** 封面图片 URL */
  coverImage?: string
  /** 文章标题 */
  title: string
  /** 文章描述 */
  description?: string
  /** 发布日期 */
  publishDate: Date
  /** 更新日期（可选） */
  updatedDate?: Date
  /** 文章分类 */
  category?: string
  /** 文章标签 */
  tags?: string[]
}

const { coverImage, title, description, publishDate, updatedDate, category, tags } = Astro.props
---

<header class="relative h-96 overflow-hidden">
  {
    coverImage && (
      <div class="absolute inset-0">
        <img
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/60 to-black/80" />
      </div>
    )
  }
  <div
    class="relative z-10 h-full flex flex-col items-center justify-center text-center px-4"
  >
    {category && (
      <span class="inline-block px-4 py-1.5 mb-4 rounded-full bg-white/20 backdrop-blur-sm text-white text-sm font-medium">
        {category}
      </span>
    )}
    <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">
      {title}
    </h1>
    {description && (
      <p class="text-base md:text-lg text-white/80 mb-6 max-w-2xl">
        {description}
      </p>
    )}
    <div class="flex flex-wrap items-center justify-center gap-4 text-white/90 text-sm">
      {updatedDate ? (
        <span>· 更新于 {updatedDate.toLocaleDateString('zh-CN')}</span>
      ) : (
        <span>{publishDate.toLocaleDateString('zh-CN')}</span>
      )}
    </div>
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
          {tags.map(tag => (
            <span class="px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm text-white/90 text-xs">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</header>
