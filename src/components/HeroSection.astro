---
// 主视觉区组件
// 用于首页的欢迎区域
// 添加中文注释

import Typewriter from './Typewriter.astro'

interface Props {
  /** 额外的 CSS 类名 */
  _className?: string
}

// @ts-ignore - className is used in template
const {
  _className = ''
} = Astro.props
---

<div class="relative flex flex-col items-center justify-center gap-4 min-h-screen w-full text-center text-white ${_className}">
  <h1 class="text-6xl font-bold">Welcome to Azuxa&apos;s BlogWorld</h1>
  <Typewriter
    textList={["Not just a blog, but", " a notebook", " a showcase", " a ground", " a world"]}
    typingSpeed={100}
    deleteSpeed={60}
    gapInterval={2000}
    cursorBlinkInterval={500}
    className="text-3xl font-mono"
  />
</div>
