---
// PageHeader.astro
// 页面头部组件
// 用于管理后台页面顶部的标题和操作区域，支持描述和自定义操作按钮

interface Props {
  /** 页面标题 */
  title: string
  /** 页面描述文本 */
  description?: string
  /** 右侧操作区域内容 */
  actions?: string
}

const { title, description, actions } = Astro.props
---

<div class="flex flex-col gap-4 rounded-3xl border border-slate-200/20 bg-white/10 px-6 py-5 shadow-[0_20px_100px_-35px_rgba(15,23,42,0.8)] backdrop-blur lg:flex-row lg:items-center lg:justify-between">
  <div>
    <p class="text-xs uppercase tracking-[0.5em] text-slate-500">管理中心</p>
    <h1 class="mt-2 text-2xl font-semibold text-[var(--admin-foreground)] lg:text-3xl">{title}</h1>
    {description && <p class="mt-2 text-sm text-slate-500 lg:text-base">{description}</p>}
  </div>
  {actions && <div class="flex shrink-0 items-center gap-3" set:html={actions} />}
</div>
