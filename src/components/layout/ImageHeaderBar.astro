---
// ImageHeaderBar.astro
// 带图片的头部栏组件
// 默认模式：编辑部眉板（弃用背景图）；文章模式：保留封面图
// 使用 Alpine.js 处理图片加载错误

// @ts-ignore - Props are used in template
interface ImageHeaderBarProps {
  src: string
  title?: string
  subtitle?: string
  mode?: 'default' | 'article'
  articleTitle?: string
  publishedAt?: string
  author?: {
    username: string
    avatar: string
  }
  readTime?: number
  section?: string
}

const {
  src,
  title,
  subtitle,
  mode = 'default',
  articleTitle,
  publishedAt,
  author,
  readTime,
  section
} = Astro.props

const fallbackSrc = '/imgs/404.jpg'
---

<!-- 文章模式 -->
{mode === 'article' && (
  <div
    x-data={`{ currentSrc: '${src}', fallbackSrc: '${fallbackSrc}' }`}
    class="relative w-full h-64 md:h-96 overflow-hidden"
  >
    <img
      :src="currentSrc"
      @error="currentSrc = fallbackSrc"
      alt={articleTitle || "article cover"}
      class="absolute inset-0 w-100 h-100 object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />

    <div class="absolute inset-0 flex flex-col justify-end md:p-10 z-10">
      <div class="text-white max-w-4xl">
        {section && (
          <div class="mb-4">
            <span class="inline-block px-3 py-1 rounded-sm border border-white/40 text-sm font-medium bg-black/30 text-white">
              {section}
            </span>
          </div>
        )}

        <h1 class="font-display text-2xl md:text-4xl font-bold mb-4 leading-tight">
          {articleTitle}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-200">
          {author && (
            <div class="flex items-center gap-2">
              <img
                src={author.avatar || '/imgs/avatar.jpg'}
                alt={author.username}
                width={24}
                height={24}
                class="border border-white/40 rounded-full"
                @error="$el.src = '/imgs/avatar.jpg'"
              />
              <span>{author.username}</span>
            </div>
          )}

          {publishedAt && (
            <>
              <span>•</span>
              <span>{new Date(publishedAt).toLocaleDateString('zh-CN')}</span>
            </>
          )}

          {readTime && (
            <>
              <span>•</span>
              <span>{readTime} 分钟阅读</span>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
)}

<!-- 默认模式：编辑部眉板 -->
{mode !== 'article' && (
  <header class="border-b-2 border-ink bg-background">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <p class="eyebrow text-primary mb-4">/ archive</p>
      <h1 class="font-display text-5xl font-bold tracking-tight text-foreground sm:text-6xl">
        {title}
      </h1>
      {
        subtitle && (
          <p class="mt-4 text-lg text-muted">{subtitle}</p>
        )
      }
      <div class="mt-6 h-1.5 w-20 bg-accent"></div>
    </div>
  </header>
)}
