---
// 分页组件
// 使用 Alpine.js 管理分页状态
// 添加中文注释

interface Props {
  /** 当前页码 */
  currentPage?: number
  /** 总页数 */
  totalPages?: number
  /** 页面改变回调函数 */
  _onPageChange?: (page: number) => void
  /** 额外的 CSS 类名 */
  _className?: string
}

const {
  currentPage = 1,
  totalPages = 1,
  _onPageChange,
  _className = ""
} = Astro.props

// 如果只有 1 页，不显示分页
const shouldRender = totalPages > 1
---

{shouldRender && (
  <div 
    x-data={`{
      page: ${currentPage},
      totalPages: ${totalPages},
      getVisiblePages() {
        if (this.totalPages <= 1) return []
        
        const delta = 2
        const range = []
        const rangeWithDots = []
        
        for (let i = Math.max(2, this.page - delta); i <= Math.min(this.totalPages - 1, this.page + delta); i++) {
          range.push(i)
        }
        
        if (this.page - delta > 2) {
          rangeWithDots.push(1, '...')
        } else {
          rangeWithDots.push(1)
        }
        
        rangeWithDots.push(...range)
        
        if (this.page + delta < this.totalPages - 1) {
          rangeWithDots.push('...', this.totalPages)
        } else {
          rangeWithDots.push(this.totalPages)
        }
        
        return rangeWithDots
      },
      
      visiblePages: [],

      init() {
        this.visiblePages = this.getVisiblePages()
      },
      
      changePage(newPage) {
        this.page = newPage
        this.visiblePages = this.getVisiblePages()
      }
    }`}
    class="flex justify-center items-center gap-2 ${_className}"
    x-cloak
  >
    <!-- 上一页按钮 -->
    <button
      @click="changePage(Math.max(1, page - 1))"
      :disabled="page === 1"
      class="px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed bg-gray-100 text-gray-600 hover:bg-gray-200"
      aria-label="上一页"
    >
      上一页
    </button>

    <!-- 页码按钮 -->
    <template x-for="pageNum in visiblePages" :key="pageNum">
      <template x-if="pageNum === '...'">
        <span class="px-3 py-2 text-gray-500">...</span>
      </template>
      <template x-else>
        <button
          @click="changePage(pageNum)"
          class="px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200"
          :class="page === pageNum ? 'bg-primary text-white shadow-lg mt-[-10px]' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
          :aria-label="`第 ${pageNum} 页`"
          :aria-current="page === pageNum ? 'page' : undefined"
          x-text="pageNum"
        ></button>
      </template>
    </template>

    <!-- 下一页按钮 -->
    <button
      @click="changePage(Math.min(totalPages, page + 1))"
      :disabled="page === totalPages"
      class="px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed bg-gray-100 text-gray-600 hover:bg-gray-200"
      aria-label="下一页"
    >
      下一页
    </button>
  </div>
)}
