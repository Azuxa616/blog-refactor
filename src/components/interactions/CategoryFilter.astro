---
// 分类筛选器组件
// Neo-Brutalism：筛选卡片 + 分类芯片

interface Category {
  name: string
  slug: string
  description?: string
  color?: string
  articleCount?: number
}

interface Props {
  /** 分类列表 */
  categories?: Category[]
  /** 选中的分类 */
  selectedCategory?: string
  /** 搜索关键词 */
  searchTerm?: string
  /** 排序类型 */
  sortType?: string
  /** 额外的 CSS 类名 */
  _className?: string
}

const {
  categories = [],
  selectedCategory = 'all',
  searchTerm,
  sortType,
  _className = ''
} = Astro.props
---

<div
  class={`panel p-8 mb-6 flex flex-col gap-4 ${_className}`}
>
  <!-- 标题栏 -->
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold text-foreground">分类</h3>
    {
      selectedCategory !== 'all' && (
        <a
          href={`/articles${searchTerm ? `?search=${searchTerm}` : ''}${sortType && sortType !== 'latest' ? `&sort=${sortType}` : ''}`}
          class="neo px-3 py-1 text-sm font-medium bg-accent text-ink-solid"
        >
          重置筛选
        </a>
      )
    }
  </div>

  <!-- 分类标签列表 -->
  <div class="flex flex-wrap gap-3">
    {
      categories.map((category) => {
        const isSelected = selectedCategory === category.slug
        return (
          <a
            href={`/articles?category=${category.slug}${searchTerm ? `&search=${searchTerm}` : ''}${sortType && sortType !== 'latest' ? `&sort=${sortType}` : ''}`}
            class:list={[
              'inline-flex items-center gap-2 px-3 py-1 text-sm font-semibold transition-colors duration-150',
              isSelected
                ? 'rounded-sm border border-ink bg-accent text-ink-solid'
                : 'chip hover:bg-muted-bg',
            ]}
          >
            <span
              class="h-2.5 w-2.5"
              style={`background-color: ${category.color || '#D64550'}`}
            >
            </span>
            {category.name} ({category.articleCount || 0})
          </a>
        )
      })
    }
  </div>
</div>
