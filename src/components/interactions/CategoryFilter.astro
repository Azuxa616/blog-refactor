---
// 分类筛选器组件
// 使用 Alpine.js 管理筛选状态
// 添加中文注释

interface Category {
  name: string
  slug: string
  description?: string
  color?: string
  articleCount?: number
}

interface Props {
  /** 分类列表 */
  categories?: Category[]
  /** 选中的分类 */
  selectedCategory?: string
  /** 搜索关键词 */
  searchTerm?: string
  /** 排序类型 */
  sortType?: string
  /** 额外的 CSS 类名 */
  _className?: string
}

const {
  categories = [],
  selectedCategory = 'all',
  searchTerm,
  sortType,
  _className = ''
} = Astro.props
---

<div
  class="relative flex bg-card-background backdrop-blur-sm border border-white/20 shadow-xl rounded-2xl p-8 hover:shadow-2xl transition-all duration-300 mb-6 flex-col gap-4 ${_className}"
>
  <!-- 标题栏 -->
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold text-foreground">分类</h3>
    {selectedCategory !== 'all' && (() => {
      const selectedCat = categories.find(c => c.slug === selectedCategory)
      const btnColor = selectedCat?.color || '#6366f1'
      return (
        <a
          href={`/articles${searchTerm ? `?search=${searchTerm}` : ''}${sortType && sortType !== 'latest' ? `&sort=${sortType}` : ''}`}
          class="px-3 py-1 text-sm rounded-full font-medium"
          style={`background-color: ${btnColor}; color: white;`}
        >
          重置筛选
        </a>
      )
    })()}
  </div>

  <!-- 分类标签列表 -->
  <div class="flex flex-wrap gap-3">
    {categories.map((category) => (
      <a
        href={`/articles?category=${category.slug}${searchTerm ? `&search=${searchTerm}` : ''}${sortType && sortType !== 'latest' ? `&sort=${sortType}` : ''}`}
        class="font-bold transition-all duration-200 hover:opacity-80 px-3 py-1 rounded-full"
        style={selectedCategory === category.slug
          ? `background-color: ${category.color}; color: white;`
          : `color: ${category.color};`
        }
      >
        {category.name} ({category.articleCount || 0})
      </a>
    ))}
  </div>
</div>
