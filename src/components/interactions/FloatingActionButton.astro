---
// FloatingActionButton.astro
// 浮动操作按钮组件
// 提供回到顶部和主题切换功能
// 使用 Alpine.js 的全局 store 和 $watch 替代 React 的 useState 和 useEffect

// 注意：此组件需要 Alpine.js 的全局 store 支持
// 在 alpine-components.js 中需要定义相关的 store 和逻辑
---

<div
  x-data="{
    isVisible: false,
    init() {
      // 初始化可见状态
      this.updateVisibility()

      // 监听滚动事件
      window.addEventListener('scroll', () => {
        this.updateVisibility()
      }, { passive: true })
    },
    updateVisibility() {
      this.isVisible = window.scrollY > 0
    },
    scrollToTop() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      })
    },
    toggleDarkMode() {
      $store.appState.toggleTheme()
    }
  }"
  class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 transition-all duration-300 ease-in-out"
>
  <!-- 回到顶部按钮 -->
  <button
    x-show="isVisible"
    x-transition.opacity.duration.300ms
    @click="scrollToTop()"
    class="w-12 h-12 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center group"
    aria-label="回到顶部"
  >
    <img src="/svgs/arrow-up.svg" width="20" height="20" class="text-gray-600 dark:text-gray-300 group-hover:text-gray-800 dark:group-hover:text-gray-100 transition-colors" alt="回到顶部" />
  </button>

    <!-- 主题切换按钮 -->
    <button
      @click="toggleDarkMode()"
      class="w-12 h-12 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-full shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center group"
      aria-label="切换主题"
    >
      <!-- 深色模式图标 -->
      <template x-if="$store.appState.theme === 'light'">
        <img src="/svgs/moon.svg" width="20" height="20" class="text-gray-600 dark:text-gray-300 group-hover:text-gray-800 dark:group-hover:text-gray-100 transition-colors" alt="深色模式" />
      </template>

      <!-- 浅色模式图标 -->
      <template x-if="$store.appState.theme === 'dark'">
        <img src="/svgs/sun.svg" width="20" height="20" class="text-gray-600 dark:text-gray-300 group-hover:text-gray-800 dark:group-hover:text-gray-100 transition-colors" alt="浅色模式" />
      </template>
    </button>
  </div>
</div>
