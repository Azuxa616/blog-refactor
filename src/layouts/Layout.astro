---
import '../styles/global.css'
import '@fontsource-variable/inter/wght.css'
import '@fontsource-variable/jetbrains-mono/wght.css'
import ThemeScript from '@/components/layout/ThemeScript.astro'
import AppLayout from '@/components/react/AppLayout'
import '../alpine-components.js'

const pathname = Astro.url.pathname
const isUseSwitch = pathname === '/'
---

<!doctype html>
<html lang="zh" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Azuxa's BlogWorld</title>
    <meta name="description" content="Azuxa's BlogWorld" />
    <ThemeScript />
  </head>
  <body class="font-sans antialiased bg-background text-foreground">
    <AppLayout client:load isUseSwitch={isUseSwitch}>
      <slot />
    </AppLayout>
  </body>
</html>
